{
  "version": 1,
  "providers": {
    "codex": {
      "scan": [
        "~/.agents/skills"
      ],
      "dedupe": "none",
      "link": "junction-ok"
    },
    "kimi": {
      "scan": [
        "~/.kimi-code/skills",
        "~/.agents/skills"
      ],
      "dedupe": "by-name-first-wins",
      "link": "junction-ok"
    },
    "claude": {
      "scan": [
        "~/.claude/skills"
      ],
      "dedupe": "by-target",
      "link": "junction-ok",
      "plugins": true
    },
    "vscode": {
      "scan": [
        "~/.copilot/skills",
        "~/.claude/skills",
        "~/.agents/skills"
      ],
      "dedupe": "none",
      "link": "junction-ok"
    }
  },
  "containers": {
    "~/.agents/skills/skills": "Mirror of the anthropics/skills repo layout; each immediate subdirectory is a skill (registry install value 'agents/skills')."
  },
